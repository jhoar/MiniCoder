# MiniCoder — example environment file.
#
# Copy this to `.env` in the repo root (already git-ignored) and fill in real values:
#   cp .env.example .env
#
# scripts/start-minicoder.sh loads .env automatically. Every `minicoder <command>` invocation
# (via bin/minicoder, pnpm exec, etc.) just reads these from the process environment, so `.env`
# only helps if something actually sources it first (start-minicoder.sh does; your shell/systemd
# unit/Docker Compose file needs to do the same for one-off CLI commands).
#
# See USER-MANUAL.md §3.3 for the full reference table and §3.5 for how these map to the
# long-running processes (`minicoder api serve`, `minicoder tasks worker`).
#
# FASTEST PATH: you don't need to fill in anything below to try MiniCoder. Just run
#   ./scripts/start-minicoder.sh
# with no `.env` at all — it defaults to SQLite plus a local Gitea instance, brings both up via
# docker compose automatically (Docker must be installed/running), and bootstraps a Gitea admin
# user + access token on first run so there's nothing to click through in a web UI. Everything in
# this file below is for the "more complex setup" cases: a real GitHub/GitLab project, PostgreSQL,
# a real LLM provider, etc. — fill in only what you actually need.

# -----------------------------------------------------------------------------------------------
# Environment identity — controls production safety guards across the codebase (db reset,
# state repair, dev/test-only commands, and scripts/start-minicoder.sh's own secret checks).
# -----------------------------------------------------------------------------------------------
APP_ENV=development
# NODE_ENV=development   # only needed if something reads NODE_ENV specifically; APP_ENV is primary

# -----------------------------------------------------------------------------------------------
# Database — SQLite (default, local/single-node) for a quick local setup, PostgreSQL for a more
# complex hosted/team deployment. Never put SQLite on a network filesystem.
# -----------------------------------------------------------------------------------------------
DB_DIALECT=sqlite

# SQLite only. Left commented out here on purpose: scripts/start-minicoder.sh supplies its own
# absolute default (<repo-root>/data/minicoder.db) when this is unset. If you uncomment it (or run
# `minicoder db migrate`/any other `minicoder` command directly, without the start script), use an
# ABSOLUTE path — `minicoder` invocations run with cwd=packages/cli (via
# `pnpm --filter @minicoder/cli exec ...`), so a relative value like `./minicoder.db` or even
# `./data/minicoder.db` silently resolves under packages/cli/ instead of the repo root, and
# `minicoder db migrate` then fails with "Cannot open database because the directory does not
# exist" (verified empirically — this is not a hypothetical footgun).
# DB_PATH=/absolute/path/to/minicoder-data/minicoder.db

# PostgreSQL — set DB_DIALECT=postgres above, then either:
#   (a) run `./scripts/start-minicoder.sh --db=postgres` and leave DB_URL unset — it brings up
#       infra/docker-compose.postgres.yml automatically and fills this in for you, or
#   (b) point DB_URL at your own existing PostgreSQL instance yourself.
# Required when DB_DIALECT=postgres, ignored otherwise.
# DB_URL=postgres://minicoder:minicoder@localhost:5432/minicoder

# PostgreSQL only — `minicoder db reset` refuses to target a host outside this allowlist unless
# --force-host is also passed. Defaults to localhost/127.0.0.1/::1 if unset.
# MINICODER_ALLOWED_RESET_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------------------------
# Orchestrator API auth — the whole auth model. No session/login system exists; a request
# authenticates via `Authorization: Bearer <key>` against one of the keys below.
# -----------------------------------------------------------------------------------------------

# Server side (minicoder api serve): a JSON array of {key, id, role, actorKind, displayName?}.
# role is one of viewer|operator|approver|admin; actorKind is human|system.
# scripts/start-minicoder.sh generates a dev-only placeholder for this if left unset — but it
# refuses to start with APP_ENV=production and this unset, so set a real one before deploying.
# MUST be single-quoted exactly like this: an unquoted or double-quoted JSON value has its inner
# `"` characters stripped by bash's `source`/quote-removal, silently corrupting the JSON (verified
# empirically — MINICODER_API_KEYS ends up as `[{key:...}]`, which fails JSON.parse at startup).
MINICODER_API_KEYS='[{"key":"REPLACE_WITH_A_LONG_RANDOM_STRING","id":"local-admin","role":"admin","actorKind":"human","displayName":"Local Admin"}]'

# Client side (CLI/Text UI/Web UI): one raw key value from the array above.
MINICODER_API_URL=http://localhost:4000
MINICODER_API_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# -----------------------------------------------------------------------------------------------
# SCM provider — GitHub, Gitea, and GitLab are all first-class `ScmClient` implementations behind
# the same provider-neutral interface; the state machine, merge gate, and review/fix loop behave
# identically regardless of which one a project's repository is on (docs/06 §Phase 18).
#
# Gitea is the quick-start default: ./scripts/start-minicoder.sh (with no config at all) brings up
# a local Gitea instance via docker compose and bootstraps GITEA_TOKEN/GITEA_BASE_URL for you — you
# don't need to fill in anything below for that path. GitHub and GitLab are the "more complex
# setup" options: a real hosted account/instance, tokens you generate yourself (USER-MANUAL.md
# §3.1.1/§3.1.2), and — for GitLab — a slow-booting local docker-compose stack if you want it local
# too (./scripts/start-minicoder.sh --scm=gitlab).
# -----------------------------------------------------------------------------------------------

# --- Gitea (default) ----------------------------------------------------------------------------
# Auto-filled by `./scripts/start-minicoder.sh` on first run when Docker is available — leave both
# unset to get the zero-touch local-Gitea quickstart. Set them yourself only if you're pointing at
# an existing Gitea instance instead of the docker-compose one.
GITEA_BASE_URL=
GITEA_TOKEN=
# GITEA_WEBHOOK_SECRET=              # optional — unset leaves /webhooks/gitea unmounted
# GITEA_WEBHOOK_SECRET_PREVIOUS=     # optional — set only while rotating GITEA_WEBHOOK_SECRET

# --- GitLab (opt in via --scm=gitlab) ------------------------------------------------------------
# GITLAB_BASE_URL=
# GITLAB_TOKEN=
# GITLAB_WEBHOOK_SECRET=             # optional — unset leaves /webhooks/gitlab unmounted
# GITLAB_WEBHOOK_SECRET_PREVIOUS=    # optional — set only while rotating GITLAB_WEBHOOK_SECRET

# --- GitHub (opt in via --scm=github) ------------------------------------------------------------
# Required for the coder/reviewer adapters to push branches/open PRs, for `minicoder merge ...`,
# `state doctor --check-scm`, and for webhook signature verification against a GitHub-provider repo.
GITHUB_TOKEN=

# Required to start `minicoder api serve` or `minicoder github serve` at all — unlike the Gitea/
# GitLab webhook secrets above, this one is currently required unconditionally, even on a
# Gitea/GitLab-only deployment (a known asymmetry; see USER-MANUAL.md §3.1.2's "Running the
# receiver" note). scripts/start-minicoder.sh fills in a dev-only placeholder for this if unset.
GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_SECRET_PREVIOUS=   # optional — set only while rotating GITHUB_WEBHOOK_SECRET

# -----------------------------------------------------------------------------------------------
# LLM provider — any OpenAI-compatible endpoint. Shared by default across the coder, reviewer,
# planner, arbiter, and documentation adapters (docs/06's reference implementations). Only needed
# once you actually run coder/reviewer/design-doc task runs — `minicoder api serve`/
# `minicoder tasks worker` start fine without these; individual task runs fail fast with an
# actionable error until set.
# -----------------------------------------------------------------------------------------------
CODE_GEN_BASE_URL=
CODE_GEN_API_KEY=
CODE_GEN_MODEL=

# Optional pricing overrides used to compute cost_records rows (defaults are gpt-4o-mini-class
# pricing) — see CLAUDE.md's Reference Coder Adapter Operational Constraints.
# CODE_GEN_PRICE_PER_1K_INPUT_TOKENS=
# CODE_GEN_PRICE_PER_1K_OUTPUT_TOKENS=
# CODER_PROMPT_TEMPLATE_VERSION=

# Optional — documentation adapter can be priced/versioned independently of the coder/reviewer.
# DOCUMENTATION_PRICE_PER_1K_INPUT_TOKENS=
# DOCUMENTATION_PRICE_PER_1K_OUTPUT_TOKENS=
# DOCUMENTATION_PROMPT_TEMPLATE_VERSION=

# -----------------------------------------------------------------------------------------------
# Coder sandbox (packages/adapters-coder) — optional; defaults to the local Docker socket with no
# egress proxy if unset. See infra/docker-compose.coder-sandbox.yml.
# -----------------------------------------------------------------------------------------------
# CODER_SANDBOX_IMAGE=
# CODER_SANDBOX_NETWORK=
# CODER_SANDBOX_DOCKER_HOST=
# CODER_SANDBOX_HTTPS_PROXY=

# -----------------------------------------------------------------------------------------------
# Merge gate policy — optional; comma-separated, case-insensitive. Defaults to
# do-not-merge,wip,blocked if unset.
# -----------------------------------------------------------------------------------------------
# MERGE_GATE_BLOCKING_LABELS=

# -----------------------------------------------------------------------------------------------
# Observability — optional. `minicoder observability export-otel` is a no-op unless this is set.
# -----------------------------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------------------------
# scripts/start-minicoder.sh tuning — all optional, shown here with the script's own defaults.
# -----------------------------------------------------------------------------------------------
# SCM_STACK=gitea                   # gitea (default) | gitlab | github | none — same as --scm=...
# API_PORT=4000
# API_HOST=0.0.0.0
# GITHUB_SERVE_PORT=3100            # only used with --webhook-only
# WEB_UI_PORT=3000                  # only used with START_WEB_UI=true
# WORKER_COUNT=1                    # number of `minicoder tasks worker` processes to start
# START_WEB_UI=false
# TASK_WORKER_POLL_INTERVAL_MS=2000
# TASK_WORKER_BATCH_SIZE=10
# TASK_WORKER_STALE_CLAIM_MS=300000
