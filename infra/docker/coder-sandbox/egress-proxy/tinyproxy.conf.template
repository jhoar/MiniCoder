User tinyproxy
Group tinyproxy
Port 8888
Listen 0.0.0.0
Timeout 600
LogLevel Info
PidFile "/var/run/tinyproxy/tinyproxy.pid"

# Default-deny: only hostnames matched by /etc/tinyproxy/filter.txt (regex, one per line) are
# reachable — docs/07 §6's "default-deny egress: only the assigned LLM provider and GitHub are
# allow-listed."
Filter "/etc/tinyproxy/filter.txt"
FilterDefaultDeny Yes
FilterExtended On

Allow 0.0.0.0/0
